  "dependencies": {
    "chess.js": "1.4.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
